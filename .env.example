# ============================================================
# NASDAQ Day Trading Predictor — Environment Variables
# ============================================================
# Copy this file to .env and fill in values as needed.
#   cp .env.example .env
# ============================================================

# ── Mode ──────────────────────────────────────────────────
# 'local' = read/write to ./_lake/ directory
# 'aws'   = read/write to S3 bucket
MODE=local

# ── AWS Configuration ────────────────────────────────────
# Required when MODE=aws or running AWS deployment scripts
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCOUNT_ID=

# ── S3 ───────────────────────────────────────────────────
# S3_BUCKET=stock-predictor-lake-<your-id>

# ── ECR ──────────────────────────────────────────────────
# ECR_REGISTRY=<account-id>.dkr.ecr.us-east-1.amazonaws.com
# ECR_REPOSITORY=stock-predictor

# ── ECS ──────────────────────────────────────────────────
# ECS_CLUSTER=stock-predictor-cluster
# ECS_EXECUTION_ROLE_ARN=arn:aws:iam::<account-id>:role/stock-predictor-ecs-execution-role
# ECS_TASK_ROLE_ARN=arn:aws:iam::<account-id>:role/stock-predictor-task-role

# ── Networking (Default VPC) ─────────────────────────────
# VPC_SUBNETS=subnet-xxxxx,subnet-yyyyy
# SECURITY_GROUP=sg-xxxxx

# ── Glue ─────────────────────────────────────────────────
# GLUE_DATABASE=stock_predictor

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
